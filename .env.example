# Copie para .env.local e preencha. O .env.local nunca vai para o Git.

# --- Supabase (obrigatório) ---
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: ignora o RLS. Use só no servidor e nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta com o Postgres, usada apenas por `npm run db:migrate`
POSTGRES_URL_NON_POOLING=

# --- Cron dos monitores (obrigatório em produção) ---
# Qualquer texto longo e aleatório. Ex.: openssl rand -hex 32
CRON_SECRET=

# --- Chaves das fontes (opcional) ---
# Também podem ser cadastradas pela tela Configurações, que tem prioridade.
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
ANTHROPIC_API_KEY=
